# Configuración de Base de Datos
DB_HOST=localhost
DB_NAME=ia_automatic_blogger
DB_USER=root
DB_PASS=

# Configuración de la API de Google Gemini (AI Studio)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Configuración de Correo Electrónico (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS="tu_contraseña_de_aplicacion_aqui"
SMTP_SECURE=tls
MAIL_FROM_EMAIL=tu_correo@gmail.com
MAIL_FROM_NAME="Nombre del Remitente"

# Credenciales del Panel de Control de Administración
ADMIN_USER=admin
ADMIN_PASS=admin123

# Modo Desarrollo (MOCK) - Evita consumo de la API de Gemini en pruebas
DEV_MODE=false

